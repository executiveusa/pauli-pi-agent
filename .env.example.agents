# ============================================================================
# MASTER AGENT CONFIGURATION
# Each agent works with ONLY their company's context (strict isolation)
# NO cross-agent access - complete data separation
# ============================================================================

# Global Agent Settings
AGENT_ISOLATION_MODE=true          # Enforce strict per-agent isolation
AGENT_AUTO_UPDATE=true             # Auto-run agents on schedule
AGENT_UPDATE_INTERVAL_MINUTES=360  # Run every 6 hours
AGENT_COMMIT_UPDATES=true          # Auto-commit content to git

# ============================================================================
# HERMES (Macs Digital) - Master Agent #1
# Platform: LinkedIn → YouTube
# Geo: US
# Model: NousResearch Hermes via OpenRouter
# ============================================================================
HERMES_NOUS_API_KEY=sk-nousresearch-xxxxx
HERMES_CONTEXT_PATH=companies/macs-digital

# ============================================================================
# VYAPARI (MyWebLane) - Master Agent #2
# Platform: YouTube Hindi → Instagram
# Geo: IN (India)
# Language: Hindi + English (bilingual)
# Model: Claude Haiku
# ============================================================================
VYAPARI_ANTHROPIC_API_KEY=sk-ant-xxxxx
VYAPARI_CONTEXT_PATH=companies/myweb-lane

# ============================================================================
# PAULI (The Pauli Effect) - Master Agent #3
# Platform: TikTok → Instagram Reels
# Geo: US
# Model: Claude Haiku
# ============================================================================
PAULI_ANTHROPIC_API_KEY=sk-ant-xxxxx
PAULI_CONTEXT_PATH=companies/pauli-effect

# ============================================================================
# KUPURI (Kupuri Media) - Master Agent #4
# Platform: Instagram → TikTok LATAM
# Geo: MX (Mexico)
# Language: Spanish + English
# Model: Claude Haiku
# ============================================================================
KUPURI_ANTHROPIC_API_KEY=sk-ant-xxxxx
KUPURI_CONTEXT_PATH=companies/kupuri-media

# ============================================================================
# CHEGGIE (Cheggie) - Master Agent #5
# Platform: LinkedIn → Instagram
# Geo: RS (Serbia)
# Language: Serbian + English
# Model: Claude Haiku
# ============================================================================
CHEGGIE_ANTHROPIC_API_KEY=sk-ant-xxxxx
CHEGGIE_CONTEXT_PATH=companies/cheggie

# ============================================================================
# CASCADIA (Cascadia Atlas) - Master Agent #6
# Platform: Demo-driven → LinkedIn
# Geo: PNW (Pacific Northwest)
# Model: Claude Opus (most capable for complex reasoning)
# ============================================================================
CASCADIA_ANTHROPIC_API_KEY=sk-ant-xxxxx
CASCADIA_CONTEXT_PATH=companies/cascadia-atlas

# ============================================================================
# CIRCULATION & SYNC
# All agent updates flow through this for visibility (read-only to others)
# ============================================================================
CIRCULATION_ENABLED=true
CIRCULATION_STORE=companies/_circulation/latest.json
CIRCULATION_NOTIFY=true

# ============================================================================
# OPENROUTER (Hermes fallback/routing)
# ============================================================================
OPENROUTER_API_KEY=sk-or-xxxxx

# ============================================================================
# GITHUB (for auto-commits of agent content)
# ============================================================================
GITHUB_TOKEN=ghp_xxxxx

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=production
