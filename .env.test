# Test environment secrets - for testing only, never commit real secrets

# LLM Proxy
LLM_PROXY_URL=http://localhost:8082
LLM_PROXY_TOKEN=test-proxy-token
LLM_PROXY_ENABLED=true

# API Keys - Test Values (these are fake keys for testing)
OPENROUTER_API_KEY=sk-or-test-1234567890abcdef
GEMINI_API_KEY=test-gemini-key-12345
GROQ_API_KEY=test-groq-key-12345
MISTRAL_API_KEY=test-mistral-key-12345
ZAI_API_KEY=test-zai-key-12345
GITHUB_TOKEN=ghp_test1234567890abcdefghijklmnopqrst
CLOUDFLARE_API_TOKEN=test-cloudflare-token-12345
CLOUDFLARE_ACCOUNT_ID=test-account-id-12345
HUGGINGFACE_TOKEN=hf_test1234567890abcdefghijklmnopqrst
ANTHROPIC_API_KEY=sk-ant-test-1234567890abcdef
OPENAI_API_KEY=sk-test-1234567890abcdefghijklmnopqrst
FIRECRAWL_API_KEY=test-firecrawl-key-12345
NOTION_API_TOKEN=test-notion-token-12345
SUPABASE_ACCESS_TOKEN=test-supabase-token-12345
VERCEL_TOKEN=test-vercel-token-12345

# ArchonX Mercury Voice Agent
INCEPTION_API_KEY=test-inception-key-12345
MERCURY_MODEL=mercury-2
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_DEFAULT_REASONING=low
MERCURY_VOICE_REASONING=instant
MERCURY_OPERATOR_REASONING=medium
MERCURY_DIFFUSION_ENABLED=true

# Voice (STT/TTS)
VOICE_STT_PROVIDER=openai
VOICE_TTS_PROVIDER=openai
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=shimmer

# ArchonX Tenant System
ARCHONX_CONTROL_PLANE_URL=http://localhost:3000
ARCHONX_TENANT_CONFIG_MODE=local
ARCHONX_DEFAULT_TENANT_ID=client_demo
ARCHONX_USAGE_LOGGING=true
ARCHONX_CLIENT_BYOK_DEFAULT=true

# Pauli Brain / Second Brain
SUPABASE_URL=http://localhost:8001
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-12345
SUPABASE_ANON_KEY=test-anon-key-12345
DATABASE_URL=postgresql://postgres:testpass@localhost:5434/second_brain

# Environment
NODE_ENV=test
